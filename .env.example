# TrustNet Environment Variables
#
# Copy this file to .env and configure secrets.
# NEVER commit .env to version control!

# Operational Environment (development | production)
# Note: In 'production', the service strictly refuses to start without valid API keys.
ENVIRONMENT=development

# Comma-separated list of authorized API keys for X-API-Key header authentication
TRUSTNET_API_KEYS=dev-test-key-12345,staging-client-key-67890

# Optional Server Overrides
PORT=8000
HOST=0.0.0.0
