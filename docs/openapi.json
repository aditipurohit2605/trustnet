          "verdict",
          "confidence"
        ],
        "title": "ClaimReport",
        "description": "Complete verification report for a claim, containing evidence items,\nthe final verdict, confidence score, and any noted gaps."
      },
      "ConflictInfo": {
        "properties": {
          "has_conflict": {
            "type": "boolean",
