          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Confidence must be between 0 and 1."
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained",
            "description": "Flag indicating if the system abstained from making a definitive verdict.",
            "default": false
          },
          "raw_probabilities": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Probabilities",
            "description": "Uncalibrated model output probability distribution."
          },
          "calibrated_probabilities": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibrated Probabilities",
            "description": "Calibrated probability distribution for dashboard and reporting."
          },
          "abstention_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstention Reason",
            "description": "Explanation if system abstains."
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/Gap"
            },
            "type": "array",
            "title": "Gaps"
          },
          "source_weights": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SourceWeight"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Weights"
          },
          "conflict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConflictInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "temporal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TemporalInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "manipulation": {
            "anyOf": [
