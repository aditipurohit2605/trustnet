# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Data directories (preserving directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/corpus/*
!data/corpus/.gitkeep

# Model checkpoints
checkpoints/
model_checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
