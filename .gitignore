# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Data directories (preserving directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.jsonl
data/corpus/*
!data/corpus/.gitkeep
!data/corpus/*.jsonl


# Model checkpoints and outputs
outputs/
checkpoints/
model_checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
